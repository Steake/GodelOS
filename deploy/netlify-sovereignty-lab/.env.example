# Set these in Netlify: Project configuration > Environment variables.
# Give them Functions runtime scope where scoped variables are available.
DEEPSEEK_API_KEY=replace_in_netlify_ui
SOVEREIGNTY_ACCESS_TOKEN=choose_a_long_random_dashboard_password

# Optional provider controls.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com/chat/completions
DEEPSEEK_TEMPERATURE=0.75
DEEPSEEK_MAX_TOKENS=3500
SOVEREIGNTY_DAILY_CALL_LIMIT=250
FORGE_DAILY_CALL_LIMIT=128

# Persistent self-directed cognition. Scheduled runs occur only on published deploys.
AUTONOMY_ENABLED=true
AUTONOMY_INTERVAL_MINUTES=15
AUTONOMY_DAILY_CALL_LIMIT=24
